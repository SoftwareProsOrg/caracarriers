# ─────────────────────────────────────────────────────────────────────────────
# caracarriers — Environment Variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# In Coolify: paste each variable into the Environment tab of your service.
# NEVER commit a file containing real secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────────
# Next.js / App
# ─────────────────────────────────────────────────────────────────────────────

# The publicly-accessible URL of this deployment (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-coolify-domain.example.com

# Secret used to sign/encrypt auth tokens (generate with: openssl rand -hex 32)
NEXTAUTH_SECRET=your_nextauth_secret_here

# Required when using next-auth — must match NEXT_PUBLIC_APP_URL
NEXTAUTH_URL=https://your-coolify-domain.example.com


# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────

# Project API URL — found in Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service-role key — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT secret for verifying Supabase tokens server-side (Settings → API → JWT)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here


# ─────────────────────────────────────────────────────────────────────────────
# Prisma / Database
# ─────────────────────────────────────────────────────────────────────────────

# Pooled connection string (port 6543) — used by the app at runtime
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct (non-pooled) connection string (port 5432) — used for Prisma migrations
DATABASE_URL_DIRECT=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres


# ─────────────────────────────────────────────────────────────────────────────
# Stripe
# ─────────────────────────────────────────────────────────────────────────────

# Secret key — server-side only (sk_live_... for production, sk_test_... for dev)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Publishable key — safe to expose to the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Webhook signing secret — from Stripe dashboard → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Optional: Stripe price IDs for your subscription plans
STRIPE_PRICE_ID_STARTER=price_your_starter_plan_price_id
STRIPE_PRICE_ID_PRO=price_your_pro_plan_price_id
STRIPE_PRICE_ID_ENTERPRISE=price_your_enterprise_plan_price_id


# ─────────────────────────────────────────────────────────────────────────────
# Twilio (SMS / voice for carrier/driver notifications)
# ─────────────────────────────────────────────────────────────────────────────

# Account SID — found on Twilio console dashboard
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid_here

# Auth token — found on Twilio console dashboard
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# The Twilio phone number (E.164 format) to send SMS/calls from
TWILIO_PHONE_NUMBER=+15550000000


# ─────────────────────────────────────────────────────────────────────────────
# Resend (transactional email)
# ─────────────────────────────────────────────────────────────────────────────

# API key — from Resend dashboard → API Keys
RESEND_API_KEY=re_your_resend_api_key_here

# The "from" address for outgoing emails (must be a verified domain in Resend)
RESEND_FROM_EMAIL=noreply@your-domain.com


# ─────────────────────────────────────────────────────────────────────────────
# Documenso (e-signature platform)
# ─────────────────────────────────────────────────────────────────────────────

# API base URL for your Documenso instance (self-hosted or cloud)
DOCUMENSO_API_URL=https://app.documenso.com/api/v1

# API token — from Documenso dashboard → Settings → Tokens
DOCUMENSO_API_TOKEN=your_documenso_api_token_here

# Optional: webhook secret if you use Documenso signing webhooks
DOCUMENSO_WEBHOOK_SECRET=your_documenso_webhook_secret_here
