generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum LoadStatus {
  AVAILABLE
  BOOKED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  PROBLEM
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum DocumentType {
  BOL
  POD
  RATE_CONFIRMATION
  INSURANCE_CERTIFICATE
  CONTRACT
  CARRIER_PACKET
  W9
  OTHER
}

enum DocumentStatus {
  PENDING_UPLOAD
  COMPLETE
  MISSING
  EXPIRING_SOON
  EXPIRED
}

enum SigningStatus {
  DRAFT
  PENDING
  SIGNED
  DECLINED
  EXPIRED
}

enum CarrierStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum EquipmentType {
  DRY_VAN
  FLATBED
  REEFER
  STEP_DECK
  LOWBOY
  TANKER
  BOX_TRUCK
  POWER_ONLY
  OTHER
}

enum UserRole {
  ADMIN
  DISPATCHER
  AGENT
  ACCOUNTING
  READONLY
}

enum InsuranceStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
}

enum AuthorityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  REVOKED
}

enum CarrierPaymentMethod {
  CHECK
  ACH
  WIRE
  FUEL_CARD
  FACTORING
  OTHER
}

enum LoadEventType {
  STATUS_CHANGE
  CHECK_CALL
  NOTE
  CARRIER_ASSIGNED
  DOCUMENT_UPLOADED
}

// ─── Models ──────────────────────────────────────────────────────────────────

// Lead model for capturing potential customers
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  origin    String?
  destination String?
  equipmentType String?
  weight    String?
  pickupDate String?
  notes     String?
  source    String? @default("website") // e.g., website, facebook, google
  status    String  @default("new") // new, contacted, qualified, etc.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([status])
  @@map("leads")
}

// The brokerage company — supports multi-tenant
model Company {
  id        String   @id @default(cuid())
  name      String
  mcNumber  String?  @unique @map("mc_number")
  dotNumber String?  @unique @map("dot_number")
  address   String?
  city      String?
  state     String?
  zip       String?
  phone     String?
  email     String?
  website   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users           User[]
  loads           Load[]
  carriers        Carrier[]
  shippers        Shipper[]
  invoices        Invoice[]
  documents       Document[]
  deals           Deal[]
  crmActivities   CrmActivity[]
  communications  Communication[]
  ediDocuments    EdiDocument[]
  apiKeys         ApiKey[]
  portalUsers     PortalUser[]
  laneHistories   LaneHistory[]

  @@map("companies")
}

// Platform users — dispatchers, agents, admins (linked to Supabase auth.users)
model User {
  id        String   @id @default(cuid())
  authId    String?  @unique @map("auth_id")
  companyId String   @map("company_id")
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  phone     String?
  role      UserRole @default(DISPATCHER)
  avatarUrl String?  @map("avatar_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company @relation(fields: [companyId], references: [id])
  dispatched   Load[]  @relation("AssignedDispatcher")
  createdLoads Load[]  @relation("CreatedBy")

  @@index([companyId])
  @@index([authId])
  @@map("users")
}

// Shipper / Customer companies
model Shipper {
  id           String  @id @default(cuid())
  companyId    String  @map("company_id")
  name         String
  contactName  String? @map("contact_name")
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  zip          String?
  creditLimit  Decimal? @map("credit_limit") @db.Decimal(12, 2)
  paymentTerms Int      @default(30) @map("payment_terms")
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  loads        Load[]
  invoices     Invoice[]
  portalUsers  PortalUser[]

  @@index([companyId])
  @@map("shippers")
}

// Carrier companies
model Carrier {
  id              String          @id @default(cuid())
  companyId       String          @map("company_id")
  name            String
  mcNumber        String?         @map("mc_number")
  dotNumber       String?         @map("dot_number")
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  zip             String?
  status          CarrierStatus   @default(PENDING)
  insuranceStatus InsuranceStatus @default(ACTIVE) @map("insurance_status")
  insuranceExpiry DateTime?       @map("insurance_expiry")
  authorityStatus AuthorityStatus @default(ACTIVE) @map("authority_status")
  safetyRating    String?         @map("safety_rating")
  rating          Decimal?        @db.Decimal(3, 2)
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  company   Company            @relation(fields: [companyId], references: [id])
  equipment CarrierEquipment[]
  loads     Load[]
  documents Document[]
  payments  CarrierPayment[]

  @@index([companyId])
  @@index([mcNumber])
  @@map("carriers")
}

model CarrierEquipment {
  id        String        @id @default(cuid())
  carrierId String        @map("carrier_id")
  type      EquipmentType

  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@index([carrierId])
  @@map("carrier_equipment")
}

// Freight loads / shipments — core of the TMS
model Load {
  id           String    @id @default(cuid())
  companyId    String    @map("company_id")
  loadNumber   String    @unique @map("load_number")
  shipperId    String?   @map("shipper_id")
  carrierId    String?   @map("carrier_id")
  dispatcherId String?   @map("dispatcher_id")
  createdById  String?   @map("created_by_id")
  status       LoadStatus @default(AVAILABLE)
  equipmentType EquipmentType @map("equipment_type")

  // Origin
  originAddress String?  @map("origin_address")
  originCity    String   @map("origin_city")
  originState   String   @map("origin_state")
  originZip     String?  @map("origin_zip")
  pickupDate    DateTime @map("pickup_date")
  pickupWindow  String?  @map("pickup_window")

  // Destination
  destAddress    String?  @map("dest_address")
  destCity       String   @map("dest_city")
  destState      String   @map("dest_state")
  destZip        String?  @map("dest_zip")
  deliveryDate   DateTime @map("delivery_date")
  deliveryWindow String?  @map("delivery_window")

  // Cargo
  commodity   String?
  weight      Decimal? @db.Decimal(10, 2)
  pieces      Int?
  hazmat      Boolean  @default(false)
  temperature String?

  // Financials
  shipperRate   Decimal  @map("shipper_rate") @db.Decimal(10, 2)
  carrierRate   Decimal? @map("carrier_rate") @db.Decimal(10, 2)
  fuelSurcharge Decimal? @map("fuel_surcharge") @db.Decimal(10, 2)
  miles         Int?

  // Tracking
  currentLocation String?  @map("current_location")
  eta             DateTime?
  proNumber       String?  @map("pro_number")
  poNumber        String?  @map("po_number")
  bolNumber       String?  @map("bol_number")
  sealNumber      String?  @map("seal_number")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id])
  shipper    Shipper?    @relation(fields: [shipperId], references: [id])
  carrier    Carrier?    @relation(fields: [carrierId], references: [id])
  dispatcher User?       @relation("AssignedDispatcher", fields: [dispatcherId], references: [id])
  createdBy  User?       @relation("CreatedBy", fields: [createdById], references: [id])
  events          LoadEvent[]
  documents       Document[]
  invoice         Invoice?
  trackingEvents  TrackingEvent[]
  communications  Communication[]
  ediDocuments    EdiDocument[]

  @@index([companyId])
  @@index([shipperId])
  @@index([carrierId])
  @@index([status])
  @@index([pickupDate])
  @@index([companyId, status])
  @@map("loads")
}

// Immutable audit trail of load lifecycle events (status changes, check calls, notes, document uploads)
model LoadEvent {
  id         String        @id @default(cuid())
  loadId     String        @map("load_id")
  status     LoadStatus?
  eventType  LoadEventType @default(STATUS_CHANGE) @map("event_type")
  userId     String?       @map("user_id")
  location   String?
  notes      String?
  occurredAt DateTime      @default(now()) @map("occurred_at")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@map("load_events")
}

// Invoices sent to shippers
model Invoice {
  id                    String        @id @default(cuid())
  companyId             String        @map("company_id")
  invoiceNumber         String        @unique @map("invoice_number")
  loadId                String?       @unique @map("load_id")
  shipperId             String        @map("shipper_id")
  status                InvoiceStatus @default(DRAFT)
  amount                Decimal       @db.Decimal(12, 2)
  tax                   Decimal       @default(0) @db.Decimal(12, 2)
  issuedAt              DateTime      @default(now()) @map("issued_at")
  dueAt                 DateTime      @map("due_at")
  paidAt                DateTime?     @map("paid_at")
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  notes                 String?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  load    Load?   @relation(fields: [loadId], references: [id])
  shipper Shipper @relation(fields: [shipperId], references: [id])

  @@index([companyId])
  @@index([shipperId])
  @@index([status])
  @@index([dueAt])
  @@map("invoices")
}

// Payments made to carriers (settlements)
model CarrierPayment {
  id        String               @id @default(cuid())
  carrierId String               @map("carrier_id")
  amount    Decimal              @db.Decimal(12, 2)
  method    CarrierPaymentMethod @default(ACH)
  reference String?
  paidAt    DateTime             @default(now()) @map("paid_at")
  notes     String?
  createdAt DateTime             @default(now()) @map("created_at")

  carrier Carrier @relation(fields: [carrierId], references: [id])

  @@index([carrierId])
  @@map("carrier_payments")
}

// Documents — BOLs, PODs, rate confirmations, insurance certs, contracts
model Document {
  id            String         @id @default(cuid())
  companyId     String         @map("company_id")
  loadId        String?        @map("load_id")
  carrierId     String?        @map("carrier_id")
  type          DocumentType
  name          String
  status        DocumentStatus @default(PENDING_UPLOAD)
  signingStatus SigningStatus? @map("signing_status")
  fileUrl       String?        @map("file_url")
  filePath      String?        @map("file_path")
  documensoId   Int?           @map("documenso_id")
  expiresAt     DateTime?      @map("expires_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id])
  load     Load?    @relation(fields: [loadId], references: [id])
  carrier  Carrier? @relation(fields: [carrierId], references: [id])

  @@index([companyId])
  @@index([loadId])
  @@index([carrierId])
  @@index([expiresAt])
  @@map("documents")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model Deal {
  id                String    @id @default(cuid())
  companyId         String    @map("company_id")
  leadId            String?   @map("lead_id")
  name              String
  stage             String    @default("lead")
  value             Decimal?  @db.Decimal(12, 2)
  probability       Int       @default(10)
  assignedTo        String?   @map("assigned_to")
  notes             String?
  expectedCloseDate DateTime? @map("expected_close_date")
  closedAt          DateTime? @map("closed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([stage])
  @@map("deals")
}

model CrmActivity {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  dealId    String?  @map("deal_id")
  leadId    String?  @map("lead_id")
  type      String
  subject   String
  body      String?
  userId    String?  @map("user_id")
  completed Boolean  @default(false)
  dueAt     DateTime? @map("due_at")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([dealId])
  @@map("crm_activities")
}

// ─── Tracking ─────────────────────────────────────────────────────────────────

model TrackingEvent {
  id           String   @id @default(cuid())
  loadId       String   @map("load_id")
  latitude     Float
  longitude    Float
  speed        Float?
  heading      Float?
  locationName String?  @map("location_name")
  recordedAt   DateTime @default(now()) @map("recorded_at")
  source       String?  @default("gps")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@index([recordedAt])
  @@map("tracking_events")
}

// ─── Communications ───────────────────────────────────────────────────────────

model Communication {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  loadId    String?  @map("load_id")
  type      String
  direction String   @default("outbound")
  subject   String?
  body      String?
  fromAddr  String?  @map("from_addr")
  toAddr    String?  @map("to_addr")
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  load    Load?   @relation(fields: [loadId], references: [id])

  @@index([companyId])
  @@index([loadId])
  @@map("communications")
}

// ─── EDI ──────────────────────────────────────────────────────────────────────

model EdiDocument {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  loadId      String?   @map("load_id")
  ediType     String    @map("edi_type")
  direction   String    @default("inbound")
  rawContent  String?   @map("raw_content")
  status      String    @default("received")
  partnerId   String?   @map("partner_id")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  load    Load?   @relation(fields: [loadId], references: [id])

  @@index([companyId])
  @@index([ediType])
  @@map("edi_documents")
}

// ─── API Keys ─────────────────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  name        String
  key         String    @unique
  permissions String    @default("read")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([key])
  @@map("api_keys")
}

// ─── Portal Users ─────────────────────────────────────────────────────────────

model PortalUser {
  id           String    @id @default(cuid())
  companyId    String    @map("company_id")
  shipperId    String    @map("shipper_id")
  email        String    @unique
  passwordHash String?   @map("password_hash")
  name         String
  role         String    @default("viewer")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  shipper Shipper @relation(fields: [shipperId], references: [id])

  @@index([companyId])
  @@index([shipperId])
  @@index([email])
  @@map("portal_users")
}

// ─── Lane Rate History ────────────────────────────────────────────────────────

model LaneHistory {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  originCity    String   @map("origin_city")
  originState   String   @map("origin_state")
  destCity      String   @map("dest_city")
  destState     String   @map("dest_state")
  equipmentType String?  @map("equipment_type")
  rate          Decimal  @db.Decimal(10, 2)
  ratePerMile   Decimal? @map("rate_per_mile")
  source        String?  @default("manual")
  recordedAt    DateTime @default(now()) @map("recorded_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, originCity, originState, destCity, destState])
  @@map("lane_history")
}
